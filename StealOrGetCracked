-- ------------------------------------------------------------
-- INFINITE STAMINA (toggleable with =)
-- ------------------------------------------------------------
local UserInputService = game:GetService("UserInputService")
local lp = Players.LocalPlayer

local infStaminaEnabled = false

local function setInfStamina(on)
    infStaminaEnabled = on
    if lp then
        if on then
            lp:SetAttribute("AdminInfStamina", true)
        else
            lp:SetAttribute("AdminInfStamina", nil)
        end
    end
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Infinite Stamina",
            Text = on and "Enabled" or "Disabled",
            Duration = 1.5,
        })
    end)
    print("[InfiniteStamina] " .. (on and "enabled" or "disabled"))
end

local ok, mod = pcall(function()
    return require(lp.PlayerScripts:WaitForChild("SprintStamina", 10))
end)

if ok and mod then
    local realUpdate = mod.update
    local realGet = mod.get

    mod.update = function(dt, ...)
        if infStaminaEnabled then
            lp:SetAttribute("AdminInfStamina", true)
        end
        return realUpdate(dt, ...)
    end

    mod.get = function(...)
        if infStaminaEnabled then
            lp:SetAttribute("AdminInfStamina", true)
            local state = realGet(...)
            state.stamina = state.staminaMax
            state.fraction = 1
            state.exhausted = false
            state.recoverAt = 0
            return state
        end
        return realGet(...)
    end

    print("[InfiniteStamina] hooked SprintStamina (toggle with =)")
else
    warn("[InfiniteStamina] could not require SprintStamina — is it in PlayerScripts?")
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Equals then
        setInfStamina(not infStaminaEnabled)
    end
end)
