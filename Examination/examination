-- ============================================================
--  NPC/PLAYER HIGHLIGHTER WITH HEALTH TEXT & AIMBOT
--  - Red highlight for NPCs (workspace.Characters)
--  - Green highlight for other players
--  - Names above characters (green for players, red for enemies)
--  - Health text below name (color coded by %)
--  - Aimbot (hold right click to aim at closest NPC ONLY)
--  - Wall check (transparent objects ignored)
-- ============================================================

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Highlighter",
    LoadingTitle = "Loading...",
    LoadingSubtitle = "Highlight NPCs & Players with Health",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "Highlighter",
        FileName = "Settings"
    },
    Discord = { Enabled = false },
    KeySystem = false,
})

local MainTab = Window:CreateTab("Main", "user")

-- ===== SERVICES =====
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local Camera = Workspace.CurrentCamera
local lp = Players.LocalPlayer

-- ===== STATE =====
local highlightingEnabled = false
local aimbotEnabled = false
local wallCheckEnabled = true
local highlightData = {}
local scanConnection = nil
local cleanupConnection = nil
local aimbotConnection = nil
local healthUpdateConnection = nil
local retryQueue = {}

-- Aimbot Settings
local aimbotFOV = 200
local aimbotSmoothness = 0.7

-- ===== FIND CHARACTERS FOLDER =====
local function getCharactersFolder()
    local chars = Workspace:FindFirstChild("Characters")
    if chars then return chars end

    local playersFolder = Workspace:FindFirstChild("Players")
    if playersFolder then
        local survivors = playersFolder:FindFirstChild("Survivors")
        if survivors then return survivors end
        local killers = playersFolder:FindFirstChild("Killers")
        if killers then return killers end
        return playersFolder
    end

    return Workspace
end

-- ===== CHECK IF CHARACTER IS LOCAL PLAYER =====
local function isLocalPlayerCharacter(character)
    if not character then return false end
    local char = lp.Character
    if not char then return false end
    return character == char
end

-- ===== CHECK IF CHARACTER IS A PLAYER =====
local function isPlayerCharacter(character)
    if not character then return false end
    if isLocalPlayerCharacter(character) then return true end

    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character == character then
            return true
        end
    end
    return false
end

-- ===== CHECK IF CHARACTER IS AN NPC =====
local function isNPC(character)
    if not character then return false end
    if isLocalPlayerCharacter(character) then return false end
    return not isPlayerCharacter(character)
end

-- ===== CHECK IF CHARACTER IS ALIVE =====
local function isCharacterAlive(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local health = humanoid:GetAttribute("Health") or humanoid.Health
        return health and health > 0
    end
    return true
end

-- ===== GET HEALTH VALUES =====
local function getHealthValues(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil, nil end

    local currentHealth = humanoid:GetAttribute("Health")
    local maxHealth = humanoid:GetAttribute("MaxHealth")

    if type(currentHealth) ~= "number" or currentHealth <= 0 then
        currentHealth = humanoid.Health
    end
    if type(maxHealth) ~= "number" or maxHealth <= 0 then
        maxHealth = humanoid.MaxHealth
    end

    if type(currentHealth) ~= "number" then currentHealth = 0 end
    if type(maxHealth) ~= "number" or maxHealth <= 0 then maxHealth = 100 end

    return currentHealth, maxHealth
end

-- ===== WALL CHECK - IGNORES TRANSPARENT OBJECTS =====
local function wallCheck(targetPosition, targetCharacter)
    if not wallCheckEnabled then return false end

    local origin = Camera.CFrame.Position
    local direction = (targetPosition - origin).Unit
    local maxDistance = (targetPosition - origin).Magnitude + 5

    local blacklist = {lp.Character, Camera}

    if targetCharacter then
        table.insert(blacklist, targetCharacter)
        for _, descendant in ipairs(targetCharacter:GetDescendants()) do
            if descendant:IsA("BasePart") or descendant:IsA("Accessory") or descendant:IsA("Model") then
                table.insert(blacklist, descendant)
            end
        end
    end

    local function raycastIgnoreTransparent(origin, direction, maxDistance, params)
        local result = Workspace:Raycast(origin, direction * maxDistance, params)

        if result then
            local hitPart = result.Instance

            if hitPart:IsA("BasePart") and hitPart.Transparency >= 1 then
                local newBlacklist = {}
                for _, obj in ipairs(params.FilterDescendantsInstances or {}) do
                    table.insert(newBlacklist, obj)
                end
                table.insert(newBlacklist, hitPart)

                local newParams = RaycastParams.new()
                newParams.FilterType = Enum.RaycastFilterType.Blacklist
                newParams.FilterDescendantsInstances = newBlacklist

                return raycastIgnoreTransparent(origin, direction, maxDistance, newParams)
            end
        end

        return result
    end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = blacklist

    local raycastResult = raycastIgnoreTransparent(origin, direction, maxDistance, raycastParams)

    if raycastResult then
        return true
    end

    return false
end

-- ===== REMOVE HIGHLIGHT FROM CHARACTER =====
local function removeHighlight(character)
    local data = highlightData[character]
    if data then
        if data.highlight then
            pcall(function() data.highlight:Destroy() end)
        end
        if data.billboard then
            pcall(function() data.billboard:Destroy() end)
        end
        if data.healthConnection then
            pcall(function()
                if type(data.healthConnection) == "table" then
                    for _, conn in ipairs(data.healthConnection) do
                        conn:Disconnect()
                    end
                else
                    data.healthConnection:Disconnect()
                end
            end)
        end
        if data.partAddedConn then
            pcall(function() data.partAddedConn:Disconnect() end)
        end
        highlightData[character] = nil
    end

    retryQueue[character] = nil
end

-- ===== GET BEST ATTACHMENT POINT =====
local function getBestAttachment(character)
    local possibleAttachments = {
        character:FindFirstChild("Head"),
        character:FindFirstChild("HumanoidRootPart"),
        character:FindFirstChild("UpperTorso"),
        character:FindFirstChild("Torso"),
        character.PrimaryPart
    }

    for _, attachment in ipairs(possibleAttachments) do
        if attachment then
            return attachment
        end
    end

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("BasePart") then
            return child
        end
    end

    return nil
end

-- ===== CREATE NAME + HEALTH BILLBOARD (two stacked text labels) =====
local function createNameBillboard(character, name, nameColor)
    local attachment = getBestAttachment(character)
    if not attachment then return nil, nil, nil, nil end
    if not attachment.Parent or not attachment.Parent.Parent then
        return nil, nil, nil, nil
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "NameBillboard"
    billboard.Adornee = attachment
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = attachment

    -- Name label
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(1, 0, 0, 25)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = name
    nameLabel.TextColor3 = nameColor
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = billboard

    -- Health label
    local healthText = Instance.new("TextLabel")
    healthText.Name = "HealthLabel"
    healthText.Size = UDim2.new(1, 0, 0, 22)
    healthText.Position = UDim2.new(0, 0, 0, 25)
    healthText.BackgroundTransparency = 1
    healthText.Text = "?/?"
    healthText.TextColor3 = Color3.fromRGB(0, 255, 0)
    healthText.TextStrokeTransparency = 0
    healthText.TextStrokeColor3 = Color3.new(0, 0, 0)
    healthText.TextScaled = true
    healthText.Font = Enum.Font.GothamMedium
    healthText.Parent = billboard

    -- Return healthText in both slots so existing code paths keep working
    return billboard, healthText, healthText, nil
end

-- ===== VERIFY BILLBOARD EXISTS =====
local function verifyBillboard(character)
    local data = highlightData[character]
    if not data then return false end

    if not data.billboard or not data.billboard.Parent then
        return false
    end

    if not data.healthText or not data.healthText.Parent then
        return false
    end

    return true
end

-- ===== UPDATE HEALTH TEXT (color coded, always a real number) =====
local function updateHealthBar(character)
    local data = highlightData[character]
    if not data then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local currentHealth, maxHealth = getHealthValues(character)
    if type(currentHealth) ~= "number" or type(maxHealth) ~= "number" or maxHealth <= 0 then
        return
    end

    local healthPercentage = math.clamp(currentHealth / maxHealth, 0, 1)

    if data.healthText then
        local text = math.floor(currentHealth) .. "/" .. math.floor(maxHealth)
        if data.healthText.Text ~= text then
            data.healthText.Text = text
        end

        local color
        if healthPercentage > 0.6 then
            color = Color3.fromRGB(0, 255, 0)       -- green
        elseif healthPercentage > 0.3 then
            color = Color3.fromRGB(255, 220, 0)     -- yellow
        else
            color = Color3.fromRGB(255, 60, 60)     -- red
        end
        data.healthText.TextColor3 = color
    end

    if currentHealth <= 0 then
        removeHighlight(character)
    end
end

-- ===== REBUILD BILLBOARD =====
local function rebuildBillboard(character)
    local data = highlightData[character]
    if not data then return false end

    if data.billboard then
        pcall(function() data.billboard:Destroy() end)
        data.billboard = nil
        data.healthText = nil
    end

    if not character or not character.Parent then return false end
    if not isCharacterAlive(character) then return false end

    local isPlayer = data.isPlayer
    local nameColor = isPlayer and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 60, 60)

    local billboard, _, healthText = createNameBillboard(character, character.Name, nameColor)

    if billboard then
        data.billboard = billboard
        data.healthText = healthText
        updateHealthBar(character)
        return true
    end

    return false
end

-- ===== RETRY BILLBOARD =====
local function retryBillboard(character)
    if retryQueue[character] then return end
    retryQueue[character] = true

    task.spawn(function()
        for attempt = 1, 5 do
            task.wait(0.5 * attempt)

            if not character or not character.Parent then
                retryQueue[character] = nil
                return
            end
            if not highlightingEnabled then
                retryQueue[character] = nil
                return
            end
            if not highlightData[character] then
                retryQueue[character] = nil
                return
            end

            if rebuildBillboard(character) then
                retryQueue[character] = nil
                return
            end
        end

        task.wait(3)
        if character and character.Parent and highlightData[character] then
            rebuildBillboard(character)
        end
        retryQueue[character] = nil
    end)
end

-- ===== HIGHLIGHT CHARACTER =====
local function highlightCharacter(character)
    if not character or not character.Parent then return end
    if not highlightingEnabled then return end
    if isLocalPlayerCharacter(character) then return end

    local currentHealth, maxHealth = getHealthValues(character)
    if not currentHealth or currentHealth <= 0 then return end

    if highlightData[character] then return end

    local isPlayer = isPlayerCharacter(character)
    local fillColor = isPlayer and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    local nameColor = isPlayer and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 60, 60)

    local highlight = Instance.new("Highlight")
    highlight.Adornee = character
    highlight.FillColor = fillColor
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.4
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local billboard, _, healthText = createNameBillboard(character, character.Name, nameColor)

    local data = {
        highlight = highlight,
        billboard = billboard,
        healthText = healthText,
        isPlayer = isPlayer,
        healthSource = character:FindFirstChildOfClass("Humanoid")
    }

    highlightData[character] = data

    if not billboard or not billboard.Parent then
        retryBillboard(character)
    else
        updateHealthBar(character)
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local connections = {}

        table.insert(connections, humanoid:GetAttributeChangedSignal("Health"):Connect(function()
            if highlightingEnabled and character and character.Parent then
                updateHealthBar(character)
            end
        end))

        table.insert(connections, humanoid:GetPropertyChangedSignal("Health"):Connect(function()
            if highlightingEnabled and character and character.Parent then
                updateHealthBar(character)
            end
        end))

        data.healthConnection = connections
    end

    local partAddedConn = character.ChildAdded:Connect(function(child)
        if child:IsA("BasePart") and highlightData[character] then
            local d = highlightData[character]
            if d.billboard and not d.billboard.Parent then
                rebuildBillboard(character)
            end
        end
    end)

    data.partAddedConn = partAddedConn

    return highlight
end

-- ===== SCAN CHARACTERS =====
local function scanCharacters()
    if not highlightingEnabled then return end

    local charsFolder = getCharactersFolder()
    if not charsFolder then return end

    local seenCharacters = {}

    for _, child in ipairs(charsFolder:GetChildren()) do
        if child:IsA("Model") then
            seenCharacters[child] = true
            if not highlightData[child] then
                highlightCharacter(child)
            else
                if not verifyBillboard(child) then
                    rebuildBillboard(child)
                end
            end
        end
    end

    for character, _ in pairs(highlightData) do
        if not seenCharacters[character] or not character.Parent then
            removeHighlight(character)
        end
    end
end

-- ===== FORCE REFRESH =====
local function forceRefreshHighlights()
    for character, _ in pairs(highlightData) do
        rebuildBillboard(character)
    end
    scanCharacters()
end

-- ===== HEALTH UPDATER (fixes "Label" bug for freshly spawned enemies) =====
local function startHealthUpdater()
    if healthUpdateConnection then return end
    healthUpdateConnection = RunService.Heartbeat:Connect(function()
        if not highlightingEnabled then return end
        for character, _ in pairs(highlightData) do
            if character and character.Parent then
                updateHealthBar(character)
            end
        end
    end)
end

local function stopHealthUpdater()
    if healthUpdateConnection then
        healthUpdateConnection:Disconnect()
        healthUpdateConnection = nil
    end
end

-- ===== AIMBOT FUNCTIONS (NPC ONLY) =====
local function getValidTargets()
    local targets = {}
    local charsFolder = getCharactersFolder()
    if not charsFolder then return targets end

    local mouseLocation = UserInputService:GetMouseLocation()

    for _, character in ipairs(charsFolder:GetChildren()) do
        if character:IsA("Model") then
            if isLocalPlayerCharacter(character) then continue end
            if isPlayerCharacter(character) then continue end
            if not isCharacterAlive(character) then continue end

            local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
            if not head then continue end

            local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if not onScreen then continue end

            local screenPos = Vector2.new(headPos.X, headPos.Y)
            local distanceToCursor = (screenPos - mouseLocation).Magnitude

            if distanceToCursor > aimbotFOV then continue end

            if wallCheck(head.Position, character) then continue end

            table.insert(targets, {
                character = character,
                head = head,
                distance = distanceToCursor,
                position = head.Position
            })
        end
    end

    table.sort(targets, function(a, b)
        return a.distance < b.distance
    end)

    return targets
end

local function aimAtTarget(target)
    if not target then return end

    local camera = Workspace.CurrentCamera
    local targetPos = target.position

    local lookAt = CFrame.lookAt(camera.CFrame.Position, targetPos)
    camera.CFrame = camera.CFrame:Lerp(lookAt, aimbotSmoothness)
end

local function startAimbot()
    if aimbotConnection then
        aimbotConnection:Disconnect()
        aimbotConnection = nil
    end

    aimbotConnection = RunService.RenderStepped:Connect(function()
        if not aimbotEnabled then return end
        if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

        local targets = getValidTargets()
        if #targets > 0 then
            aimAtTarget(targets[1])
        end
    end)
end

local function stopAimbot()
    if aimbotConnection then
        aimbotConnection:Disconnect()
        aimbotConnection = nil
    end
end

-- ===== CLEANUP =====
local function clearAllHighlights()
    for character, _ in pairs(highlightData) do
        removeHighlight(character)
    end
    highlightData = {}
    retryQueue = {}
end

-- ===== START HIGHLIGHTING =====
local function startHighlighting()
    if highlightingEnabled then return end

    highlightingEnabled = true
    scanCharacters()

    local charsFolder = getCharactersFolder()
    if charsFolder then
        if cleanupConnection then
            cleanupConnection:Disconnect()
            cleanupConnection = nil
        end

        cleanupConnection = charsFolder.ChildAdded:Connect(function(child)
            if highlightingEnabled and child:IsA("Model") then
                task.wait(0.5)
                highlightCharacter(child)
            end
        end)
    end

    if scanConnection then
        scanConnection:Disconnect()
        scanConnection = nil
    end

    scanConnection = RunService.Heartbeat:Connect(function()
        if highlightingEnabled then
            scanCharacters()
        end
    end)

    startHealthUpdater()

    Rayfield:Notify({
        Title = "Highlighter",
        Content = "Enabled - NPCs red, Players green, Health text shown",
        Duration = 3,
    })
end

-- ===== STOP HIGHLIGHTING =====
local function stopHighlighting()
    highlightingEnabled = false

    if scanConnection then
        scanConnection:Disconnect()
        scanConnection = nil
    end

    if cleanupConnection then
        cleanupConnection:Disconnect()
        cleanupConnection = nil
    end

    stopHealthUpdater()
    clearAllHighlights()

    Rayfield:Notify({
        Title = "Highlighter",
        Content = "Disabled",
        Duration = 2,
    })
end

